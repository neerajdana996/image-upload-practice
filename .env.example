# Copy to .env and adjust. Compose falls back to these same defaults if .env is absent.

# Host ports (container ports are fixed)
API_PORT=8000
POSTGRES_PORT=5433
MINIO_PORT=9100
MINIO_CONSOLE_PORT=9101

POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=images

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=images
